<Project Sdk="Microsoft.NET.Sdk">
  <!-- Служба PulseBarSensor: читает температуру CPU через PawnIO (нужны права) и отдаёт её строке по каналу. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PulseBar</RootNamespace>
    <AssemblyName>PulseBar.Sensor</AssemblyName>
    <AssemblyTitle>PulseBar Sensor</AssemblyTitle>
    <Description>PulseBar: служба температуры CPU (PawnIO)</Description>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" />
    <EmbeddedResource Include="Modules\*.bin" LogicalName="%(Filename).bin" />
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>
</Project>
